# Copy to .env (git-ignored). Everything is optional for scanning; keys are only needed
# for authenticated Kalshi calls (balance / positions / orders).

# Kalshi — same variables the 9crusher/mcp-server-kalshi MCP server uses.
KALSHI_ENV=demo                       # demo (sandbox, default) | prod (real money)
KALSHI_API_KEY=                       # API key ID from https://kalshi.com/account/profile (API keys)
KALSHI_PRIVATE_KEY_PATH=              # path to the RSA private key .pem you downloaded when creating the key

# Extra brake for real-money orders: prod orders are refused unless this is 1.
ARB_LIVE_TRADING=0

# Fee assumptions
ROBINHOOD_GOLD=0                      # 1 if you pay for Robinhood Gold (5% commission constant instead of 10%)
KALSHI_FEE_ROUNDING=cent              # cent (conservative, matches the published table) | centicent
POLYMARKET_US_VOLUME_REBATE=0         # 0.10 / 0.25 / 0.50 if your prior-month taker volume qualifies

# Optional sportsbook consensus (The Odds API) — not wired into the scanner yet, see docs/ROADMAP.md
ODDS_API_KEY=

# Networking: some proxies truncate chunked HTTP/1.1 responses to Python's urllib; the client
# falls back to the curl binary automatically, or force it here.
# ARB_HTTP_TRANSPORT=curl
