{
  "manifest_version": 3,
  "name": "Arb Engine Robinhood Overlay",
  "short_name": "Arb Engine",
  "version": "0.1.0",
  "description": "Fee-aware fair value, cross-venue prices (Kalshi, Polymarket) and max-buy prices overlaid on Robinhood event contracts.",
  "minimum_chrome_version": "101",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "https://robinhood.com/*",
    "https://api.robinhood.com/*",
    "https://api.elections.kalshi.com/*",
    "https://gamma-api.polymarket.com/*",
    "https://clob.polymarket.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Arb Engine", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://robinhood.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [{ "resources": ["nfl_teams.json"], "matches": ["https://robinhood.com/*"] }]
}
